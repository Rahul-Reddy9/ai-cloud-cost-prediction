# Copy to .env and fill in. Nothing here is required for the local simulator prototype.
# Only needed for the OPTIONAL Kubernetes / Prometheus stage (see deploy/README.md).
PROMETHEUS_URL=http://localhost:9090
K8S_NAMESPACE=autoscale-test
K8S_DEPLOYMENT=sample-web-app
MIN_REPLICAS=2
MAX_REPLICAS=12
# Safety: the experimental controller only logs recommendations unless this is "true".
CONTROLLER_APPLY=false
